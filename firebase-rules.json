{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && ((auth.uid == $uid && (!data.exists() || newData.child('role').val() == 'pending')) || root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'supervisor' || root.child('users').child(auth.uid).child('role').val() == 'housekeeper' || root.child('users').child(auth.uid).child('role').val() == 'front_desk')"
      }
    },
    "room_status_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "issues": {
      ".read": "auth != null",
      "$issueId": {
        ".write": "auth != null"
      }
    },
    "guest_requests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth != null"
      }
    },
    "cafe_products": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'front_desk')",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('price').isNumber() && newData.child('price').val() >= 0 && newData.child('category').isString() && newData.child('active').isBoolean() && newData.child('sortOrder').isNumber() && newData.child('createdAt').exists() && newData.child('updatedAt').exists())"
      }
    },
    "manual_notification_logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$notificationId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
      }
    }
  }
}